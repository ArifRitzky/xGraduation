# Connection string dari Neon (tombol "Connect" di dashboard Neon).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Rahasia untuk menandatangani sesi login. WAJIB diisi, minimal 32 karakter.
# Buat nilainya dengan perintah ini di terminal, lalu tempel hasilnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Alamat frontend yang boleh memanggil API ini (pisahkan dengan koma).
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

PORT=3000

# Kunci API Google untuk membaca folder Drive yang dibagikan "Anyone with the link".
# Buat di Google Cloud Console: APIs & Services > Credentials > Create credentials > API key,
# lalu batasi ("API restrictions") hanya ke "Google Drive API".
# Kunci ini hanya boleh ada di server. Jangan dimasukkan ke file frontend.
GOOGLE_API_KEY=

# Client ID OAuth untuk tombol "Masuk dengan Google" admin (Google Identity Services).
# Buat di Google Cloud Console: APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application. Nilai ini AMAN ditaruh juga di frontend (bukan rahasia),
# tapi server perlu salinannya untuk memverifikasi token yang dikirim balik.
# Kosongkan untuk mematikan tombol "Masuk dengan Google" (login password tetap jalan).
GOOGLE_CLIENT_ID=

# CATATAN: server ini TIDAK meminta akses OAuth ke folder Drive admin (bukan GOOGLE_CLIENT_SECRET
# atau ENCRYPTION_KEY). Itu sempat dicoba (scope drive.file + Google Picker) tapi dibatalkan --
# lihat komentar di db/schema.sql. Baca foto Drive tetap lewat GOOGLE_API_KEY + "anyone with link".

# Pendaftaran akun admin lewat email + password. Biarkan "false" (atau hapus baris ini).
# Akun baru dibuat lewat "Masuk dengan Google". JANGAN aktifkan di server publik sebelum email
# pendaftar diverifikasi: orang lain bisa mendaftar dengan emailmu lebih dulu.
ALLOW_PASSWORD_SIGNUP=false

# Batas jumlah project per admin (melindungi kuota GOOGLE_API_KEY yang dipakai bersama). Default 50.
MAX_PROJECTS_PER_ADMIN=50

# Alamat frontend (BUKAN backend ini) - dipakai untuk membuat link di email verifikasi &
# lupa password, misalnya "http://localhost:5500" (folder "Project Photo Selector" dibuka
# lewat Live Server) atau "https://app.domainmu.com" saat deploy. Kosongkan untuk mematikan
# fitur lupa-password/verifikasi email (endpoint terkait akan menjawab 503).
APP_URL=http://localhost:5500

# SMTP untuk mengirim email verifikasi & lupa password. Kosongkan SMTP_HOST untuk development:
# emailnya tidak benar-benar terkirim, isinya (termasuk link) dicetak ke log server, jadi tetap
# bisa dites manual. Contoh dengan Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=
# alamat Gmail-mu, SMTP_PASS= App Password (bukan password akun biasa - buat di
# myaccount.google.com/apppasswords). Layanan seperti Resend/Mailtrap/SendGrid juga bisa dipakai,
# cukup isi host/port/user/pass SMTP masing-masing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Client Photo Proofing <no-reply@example.com>

# Aktifkan HANYA di server produksi (mengaktifkan cookie Secure + SameSite=None):
# NODE_ENV=production
